        <!-- SIMPLE WEIGHT CATEGORY LOGIC -->
        <script>
            function findCategory() {
                const w = parseFloat(document.getElementById('userWeight').value);
                const res = document.getElementById('weightResult');
                if (!w) { res.innerText = "Unesite kilažu!"; return; }
                
                if (w <= 48) res.innerText = "Minimumweight (46-48 kg)";
                else if (w <= 51) res.innerText = "Flyweight (51 kg)";
                else if (w <= 54) res.innerText = "Bantamweight (54 kg)";
                else if (w <= 57) res.innerText = "Featherweight (57 kg)";
                else if (w <= 60) res.innerText = "Lightweight (60 kg)";
                else if (w <= 63.5) res.innerText = "Light Welterweight (63.5 kg)";
                else if (w <= 67) res.innerText = "Welterweight (67 kg)";
                else if (w <= 71) res.innerText = "Light Middleweight (71 kg)";
                else if (w <= 75) res.innerText = "Middleweight (75 kg)";
                else if (w <= 80) res.innerText = "Light Heavyweight (80 kg)";
                else if (w <= 86) res.innerText = "Cruiserweight (86 kg)";
                else if (w <= 92) res.innerText = "Heavyweight (92 kg)";
                else res.innerText = "Super Heavyweight (+92 kg)";
            }
        </script>
